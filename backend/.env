# ============================================
# CONFIGURACIÓN DE EMAIL PARA CHARGEWAY
# ============================================

# Servidor SMTP
# Gmail: smtp.gmail.com
# Outlook: smtp-mail.outlook.com  
# Yahoo: smtp.mail.yahoo.com
SMTP_SERVER=smtp.gmail.com

# Puerto SMTP (587 para TLS, 465 para SSL)
SMTP_PORT=587

# Tu email desde el cual se enviarán las confirmaciones
EMAIL_USER=montypohl20@gmail.com

# Contraseña del email o App Password
# IMPORTANTE: Para Gmail, usa una "Contraseña de aplicación" (App Password)
# No uses tu contraseña normal de Gmail
EMAIL_PASSWORD=akvjtmwndbhqfbhd

# Habilitar/deshabilitar envío de emails (true/false)
EMAIL_ENABLED=true

# ============================================
# INSTRUCCIONES PARA GMAIL
# ============================================
# 
# 1. Ve a https://myaccount.google.com/security
# 2. Activa la verificación en dos pasos
# 3. Ve a "Contraseñas de aplicaciones"
# 4. Selecciona "Correo" y "Otro (nombre personalizado)"
# 5. Escribe "ChargeWay"
# 6. Copia la contraseña de 16 caracteres generada
# 7. Pégala en EMAIL_PASSWORD arriba
#
# ============================================
# INSTRUCCIONES PARA OTROS SERVICIOS
# ============================================
#
# OUTLOOK/HOTMAIL:
# - SMTP_SERVER=smtp-mail.outlook.com
# - SMTP_PORT=587
# - Usa tu email y contraseña normal
#
# YAHOO:
# - SMTP_SERVER=smtp.mail.yahoo.com
# - SMTP_PORT=587
# - También requiere "Contraseña de aplicación"
#
# SENDGRID (Recomendado para producción):
# - SMTP_SERVER=smtp.sendgrid.net
# - SMTP_PORT=587
# - EMAIL_USER=apikey
# - EMAIL_PASSWORD=tu-api-key-de-sendgrid
#
# ============================================