# =========================
# BACKEND - CONFIG GENERAL
# =========================

# Flask
FLASK_ENV=development
FLASK_DEBUG=1

# Base de datos (ejemplos)
# PostgreSQL:
DATABASE_URL=postgresql://chargeway:chargeway@localhost:5432/chargeway
# SQLite (si usan en dev):
# DATABASE_URL=sqlite:///chargeway.db

# =========================
# EMAIL (SMTP)
# =========================
EMAIL_ENABLED=true

SMTP_SERVER=mail.naranja.com.py
SMTP_PORT=465
EMAIL_USE_SSL=true

# Remitente (NO pongas credenciales reales acá)
EMAIL_USER=chargeway@naranja.com.py
EMAIL_PASSWORD=CHANGE_ME

# Nombre visible del remitente
EMAIL_FROM_NAME=Chargeway - no te dejes de mover

# Soporte mostrado en el email
SUPPORT_EMAIL=soporte@chargeway.com

# Timeout (evita que se cuelgue)
EMAIL_TIMEOUT_SECONDS=12

# En DEV podés desactivar verificación si da problemas de certificado
# En PRODUCCIÓN debe ser true
EMAIL_SSL_VERIFY=false

#intruccion par crear .env:   cp .env.example .env